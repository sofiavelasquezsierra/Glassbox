# Copy to .env.local. Every variable here is server-only; none are NEXT_PUBLIC_.

# Anthropic API key used by the agent and reviewer (server-side only).
ANTHROPIC_API_KEY=

# Supabase Postgres, as the project owner. Used ONLY by local scripts
# (npm run db:migrate / db:seed). Never set this on Vercel.
DATABASE_URL_ADMIN=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Written by `npm run db:migrate`, which generates the role passwords.
# For Vercel, use the Supabase transaction pooler host (port 6543) with
# usernames glassbox_reader.<project-ref> / glassbox_app.<project-ref>.
DATABASE_URL_READONLY=
DATABASE_URL_APP=

# HMAC key that signs agent-generated SQL so /api/rerun only re-executes
# queries this server produced. Must stay stable across deploys (cached runs
# carry signatures). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GLASSBOX_SIGNING_SECRET=

# Optional model overrides (defaults shown).
# GLASSBOX_MODEL_INTENT=claude-haiku-5-5
# GLASSBOX_MODEL_PLAN=claude-sonnet-5-5
# GLASSBOX_MODEL_SQL=claude-sonnet-5-5
# GLASSBOX_MODEL_REVIEW=claude-opus-5-5

# Live-run limits (defaults shown). Per visitor (hashed IP) per hour, and per day overall.
# LIVE_RUNS_PER_HOUR=5
# LIVE_RUNS_PER_DAY=150
