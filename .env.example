# Copy to .env.local. Every variable here is server-only; none are NEXT_PUBLIC_.

# Anthropic API key used by the agent and reviewer (server-side only).
ANTHROPIC_API_KEY=

# Supabase Postgres, as the project owner. Used ONLY by local scripts
# (npm run db:migrate / db:seed). Never set this on Vercel.
DATABASE_URL_ADMIN=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Written by `npm run db:migrate`, which generates the role passwords.
# For Vercel, use the Supabase transaction pooler host (port 6543) with
# usernames glassbox_reader.<project-ref> / glassbox_app.<project-ref>.
DATABASE_URL_READONLY=
DATABASE_URL_APP=
