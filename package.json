{
  "name": "glassbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx supabase/seed.ts",
    "db:verify": "tsx scripts/db-verify.ts",
    "ask": "tsx --conditions=react-server scripts/ask.ts",
    "eval": "tsx --conditions=react-server scripts/eval.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dictionary:propose": "tsx --conditions=react-server scripts/propose-dictionary.ts",
    "record": "tsx --conditions=react-server scripts/record-runs.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@visx/scale": "^4.0.0",
    "libpg-query": "^18.2.1",
    "motion": "^14.7.1",
    "next": "^16.4.3",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
